#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ops_dir=$script_dir/ops
venv_dir=$script_dir/.venv-ansible
python=$venv_dir/bin/python
ansible=$venv_dir/bin/ansible
ansible_playbook=$venv_dir/bin/ansible-playbook

usage() {
    cat <<EOF
Usage: ./deploy <command> [Ansible options]

Commands:
  setup        Create or update the pinned Ansible environment
  coordinator  Deploy the ThinkPad coordinator
  imac         Converge the iMac endpoint
  all          Deploy the coordinator, then converge the iMac

Examples:
  ./deploy all
  ./deploy imac --tags media
  ./deploy coordinator --check
EOF
}

setup() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo "python3 is required to set up Ansible" >&2
        exit 1
    fi

    if [ ! -x "$python" ]; then
        echo "Creating $venv_dir"
        python3 -m venv "$venv_dir"
    fi

    echo "Installing pinned Ansible requirements"
    "$python" -m pip install \
        --disable-pip-version-check \
        --requirement "$ops_dir/requirements.txt"
}

ensure_environment() {
    if [ ! -x "$ansible" ] || [ ! -x "$ansible_playbook" ]; then
        setup
    fi

    if [ ! -f "$ops_dir/inventory.yml" ]; then
        cp -- "$ops_dir/inventory.example.yml" "$ops_dir/inventory.yml"
        echo "Created $ops_dir/inventory.yml from the example"
    fi
}

ping_hosts() {
    (
        cd "$ops_dir"
        "$ansible" "$1" --module-name ping
    )
}

converge() {
    host_group=$1
    playbook=$2
    shift 2

    ping_hosts "$host_group"
    (
        cd "$ops_dir"
        "$ansible_playbook" "playbooks/$playbook.yml" \
            --ask-become-pass "$@"
    )
}

command=${1:-help}
case "$command" in
    setup)
        shift
        if [ "$#" -gt 0 ]; then
            echo "setup does not accept additional options" >&2
            usage >&2
            exit 2
        fi
        setup
        ;;
    coordinator)
        shift
        ensure_environment
        converge coordinators coordinator "$@"
        ;;
    imac|endpoint)
        shift
        ensure_environment
        converge endpoints endpoint "$@"
        ;;
    all)
        shift
        ensure_environment
        ping_hosts all
        (
            cd "$ops_dir"
            "$ansible_playbook" playbooks/coordinator.yml \
                --ask-become-pass "$@"
            "$ansible_playbook" playbooks/endpoint.yml \
                --ask-become-pass "$@"
        )
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown deploy command: $command" >&2
        usage >&2
        exit 2
        ;;
esac
