#!/bin/bash

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "Run this installer as root." >&2
  exit 1
fi

source /etc/os-release

if [[ ${ID:-} != ubuntu || ${VERSION_ID:-} != 24.04 ]]; then
  echo "Speech qualification requires Ubuntu 24.04." >&2
  exit 1
fi

source_dir=$(cd -- "$(dirname -- "$0")" && pwd)
install_root=/opt/cortex-speech
model_dir=$install_root/models
whisper_version=1.9.1
whisper_model=ggml-base.en-q5_1.bin
vosk_model=vosk-model-small-en-us-0.15
piper_voice=en_US-lessac-medium

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install --yes --no-install-recommends \
  build-essential \
  ca-certificates \
  cmake \
  curl \
  libopenblas-dev \
  python3-venv \
  unzip

install -d --owner=root --group=root --mode=755 \
  "$install_root/bin" \
  "$model_dir"

python3 -m venv --clear "$install_root/qualification-venv"
"$install_root/qualification-venv/bin/python" -m pip install \
  --disable-pip-version-check \
  --no-cache-dir \
  --extra-index-url https://download.pytorch.org/whl/cpu \
  --requirement "$source_dir/requirements-speech-qualification.txt"
"$install_root/qualification-venv/bin/python" -m pip check

build_dir=$(mktemp -d)
cleanup() {
  rm -rf -- "$build_dir"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

curl \
  --fail \
  --location \
  --output "$build_dir/whisper.cpp.tar.gz" \
  "https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v$whisper_version.tar.gz"
tar -xzf "$build_dir/whisper.cpp.tar.gz" -C "$build_dir"
cmake \
  -S "$build_dir/whisper.cpp-$whisper_version" \
  -B "$build_dir/whisper.cpp-$whisper_version/build" \
  -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_SHARED_LIBS=OFF \
  -DGGML_BLAS=ON \
  -DGGML_BLAS_VENDOR=OpenBLAS
cmake \
  --build "$build_dir/whisper.cpp-$whisper_version/build" \
  --config Release \
  --parallel
install --owner=root --group=root --mode=755 \
  "$build_dir/whisper.cpp-$whisper_version/build/bin/whisper-cli" \
  "$install_root/bin/whisper-cli"

curl \
  --fail \
  --location \
  --output "$model_dir/$whisper_model" \
  "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$whisper_model"
printf '%s  %s\n' \
  d26d7ce5a1b6e57bea5d0431b9c20ae49423c94a \
  "$model_dir/$whisper_model" \
  | sha1sum --check -
curl \
  --fail \
  --location \
  --output "$build_dir/$vosk_model.zip" \
  "https://alphacephei.com/vosk/models/$vosk_model.zip"
printf '%s  %s\n' \
  30f26242c4eb449f948e42cb302dd7a686cb29a3423a8367f99ff41780942498 \
  "$build_dir/$vosk_model.zip" \
  | sha256sum --check -
unzip -q -o "$build_dir/$vosk_model.zip" -d "$model_dir"
"$install_root/qualification-venv/bin/python" \
  -m piper.download_voices \
  --data-dir "$model_dir" \
  "$piper_voice"
printf '%s  %s\n' \
  5efe09e69902187827af646e1a6e9d269dee769f9877d17b16b1b46eeaaf019f \
  "$model_dir/$piper_voice.onnx" \
  | sha256sum --check -

install --owner=root --group=root --mode=755 \
  "$source_dir/qualify_speech.py" \
  "$install_root/qualify_speech.py"
install --owner=root --group=root --mode=644 \
  "$source_dir/speech.py" \
  "$install_root/speech.py"
install --owner=root --group=root --mode=644 \
  "$source_dir/speech-candidates.json" \
  "$install_root/speech-candidates.json"

HF_HOME="$install_root/pocket-cache" \
  "$install_root/qualification-venv/bin/python" -c \
  'from pocket_tts import TTSModel; model = TTSModel.load_model(); model.get_state_for_audio_prompt("alba")'

test -x "$install_root/bin/whisper-cli"
if ldd "$install_root/bin/whisper-cli" | grep -q "not found"; then
  echo "The whisper.cpp executable has unresolved shared libraries." >&2
  exit 1
fi
test -s "$model_dir/$whisper_model"
test -d "$model_dir/$vosk_model"
test -s "$model_dir/$piper_voice.onnx"
test -s "$model_dir/$piper_voice.onnx.json"

echo "Cortex Home speech qualification installation completed."
