#!/bin/sh

set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <server-ssh-host>" >&2
  exit 1
fi

server_host=$1
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v pnpm >/dev/null 2>&1; then
  echo "Cortex Home client builds require pnpm." >&2
  exit 1
fi

pnpm --dir "$script_dir/client" install --frozen-lockfile
pnpm --dir "$script_dir/client" build

remote_dir=$(ssh "$server_host" mktemp -d)

case "$remote_dir" in
  /tmp/tmp.*) ;;
  *)
    echo "Unexpected remote temporary directory: $remote_dir" >&2
    exit 1
    ;;
esac

cleanup() {
  ssh "$server_host" "rm -rf -- '$remote_dir'" || true
}

trap cleanup EXIT
trap 'exit 1' HUP INT TERM

scp -q -r \
  "$script_dir/client/dist" \
  "$script_dir/files" \
  "$script_dir/agent_runtime.py" \
  "$script_dir/context.py" \
  "$script_dir/cortex_home.py" \
  "$script_dir/hue.py" \
  "$script_dir/speech.py" \
  "$script_dir/today.py" \
  "$script_dir/hue_pair.py" \
  "$script_dir/install-host" \
  "$script_dir/requirements.txt" \
  "$server_host:$remote_dir/"

ssh -tt "$server_host" "sudo '$remote_dir/install-host'"
