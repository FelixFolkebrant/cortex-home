[Unit]
Description=Cortex Home coordinator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cortex-home
Group=cortex-home
WorkingDirectory=/opt/cortex-home
Environment=HF_HOME=/opt/cortex-home/models/pocket-cache
EnvironmentFile=/etc/cortex-home/agent.env
ExecStart=/opt/cortex-home/venv/bin/python /opt/cortex-home/cortex_home.py
Restart=on-failure
RestartSec=2
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
