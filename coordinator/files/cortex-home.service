[Unit]
Description=Cortex Home coordinator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cortex-home
Group=cortex-home
WorkingDirectory=/opt/cortex-home
ExecStart=/usr/bin/python3 /opt/cortex-home/cortex_home.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
