#!/bin/sh

set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <server-ssh-host>" >&2
  exit 1
fi

server_host=$1
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
remote_dir=$(ssh "$server_host" mktemp -d)

case "$remote_dir" in
  /tmp/tmp.*) ;;
  *)
    echo "Unexpected remote temporary directory: $remote_dir" >&2
    exit 1
    ;;
esac

cleanup() {
  ssh "$server_host" "rm -rf -- '$remote_dir'" || true
}

trap cleanup EXIT
trap 'exit 1' HUP INT TERM

scp -q \
  "$script_dir/install-speech-host" \
  "$script_dir/qualify_speech.py" \
  "$script_dir/requirements-speech-qualification.txt" \
  "$script_dir/speech-candidates.json" \
  "$script_dir/speech.py" \
  "$server_host:$remote_dir/"

ssh -tt "$server_host" "sudo '$remote_dir/install-speech-host'"
