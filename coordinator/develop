#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(dirname -- "$script_dir")
python="$project_dir/.venv/bin/python"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "Cortex Home local development requires pnpm." >&2
  exit 1
fi
if [ ! -x "$python" ]; then
  echo "Cortex Home local development requires .venv/bin/python." >&2
  exit 1
fi

ready_directory=$(mktemp -d)
ready_file=$ready_directory/coordinator-ready
CORTEX_HOME_DEBUG=1 "$python" "$script_dir/development.py" --ready-file "$ready_file" "$@" &
coordinator_pid=$!
client_pid=

cleanup() {
  if [ -n "$client_pid" ]; then
    kill "$client_pid" 2>/dev/null || true
    wait "$client_pid" 2>/dev/null || true
  fi
  kill "$coordinator_pid" 2>/dev/null || true
  wait "$coordinator_pid" 2>/dev/null || true
  rm -rf -- "$ready_directory"
}

trap cleanup EXIT
trap 'exit 0' HUP INT TERM

for attempt in $(seq 1 50); do
  if [ -f "$ready_file" ]; then
    break
  fi
  if ! kill -0 "$coordinator_pid" 2>/dev/null; then
    wait "$coordinator_pid"
    exit 1
  fi
  sleep 0.1
done

if [ ! -f "$ready_file" ]; then
  echo "Cortex Home local coordinator did not become ready." >&2
  exit 1
fi

pnpm --dir "$script_dir/client" exec vite --host 127.0.0.1 --strictPort &
client_pid=$!
while kill -0 "$client_pid" 2>/dev/null; do
  if ! kill -0 "$coordinator_pid" 2>/dev/null; then
    echo "Cortex Home coordinator exited unexpectedly." >&2
    wait "$coordinator_pid" || true
    exit 1
  fi
  sleep 0.1
done
wait "$client_pid"
