#!/bin/bash

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "Run this installer as root." >&2
  exit 1
fi

source_dir=$(cd -- "$(dirname -- "$0")" && pwd)
raspotify_version=0.48.2~librespot.v0.8.0-9c7d756
raspotify_sha256=7f2c232af89834608bc393f6f9295a22a2659fe938f65c108b78a70c8b539733

source /etc/os-release

if [[ ${ID:-} != ubuntu || ${VERSION_ID:-} != 24.04 ]]; then
  echo "GH-005 provisioning requires Ubuntu 24.04." >&2
  exit 1
fi

if [[ $(< /sys/devices/virtual/dmi/id/product_name) != iMac8,1 ]]; then
  echo "GH-005 provisioning requires the qualified iMac8,1." >&2
  exit 1
fi

if ! id cortex-endpoint >/dev/null 2>&1; then
  echo "Provision the Cortex Home endpoint before Raspotify." >&2
  exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "Raspotify provisioning requires curl." >&2
  exit 1
fi

install --owner=root --group=root --mode=755 \
  "$source_dir/files/cortex-raspotify" \
  /usr/local/bin/cortex-raspotify
install -D --owner=root --group=root --mode=600 \
  "$source_dir/files/raspotify.conf" \
  /etc/raspotify/conf
install -D --owner=root --group=root --mode=644 \
  "$source_dir/files/raspotify.service.conf" \
  /etc/systemd/system/raspotify.service.d/50-cortex-endpoint.conf

installed_raspotify_version=$(
  dpkg-query \
    --show \
    --showformat='${Version}' \
    raspotify \
    2>/dev/null ||
    true
)

if [[ $installed_raspotify_version != "$raspotify_version" ]]; then
  raspotify_deb=$(mktemp --tmpdir raspotify.XXXXXX.deb)
  curl \
    --fail \
    --location \
    --silent \
    --show-error \
    "https://dtcooper.github.io/raspotify/raspotify-latest_amd64.deb" \
    --output "$raspotify_deb"

  if [[ $(dpkg-deb --field "$raspotify_deb" Package) != raspotify ]]; then
    echo "The downloaded package is not Raspotify." >&2
    exit 1
  fi

  if [[ $(dpkg-deb --field "$raspotify_deb" Version) != "$raspotify_version" ]]; then
    echo "The downloaded Raspotify version has not been reviewed." >&2
    exit 1
  fi

  if [[ $(dpkg-deb --field "$raspotify_deb" Architecture) != amd64 ]]; then
    echo "The downloaded Raspotify package is not amd64." >&2
    exit 1
  fi

  if ! dpkg-deb --field "$raspotify_deb" Depends | grep -q 'libasound2t64'; then
    echo "The downloaded Raspotify package has outdated Ubuntu dependencies." >&2
    exit 1
  fi

  if ! printf '%s  %s\n' "$raspotify_sha256" "$raspotify_deb" |
    sha256sum --check --status
  then
    echo "The downloaded Raspotify package checksum is not accepted." >&2
    exit 1
  fi

  chmod 644 "$raspotify_deb"
  apt-get \
    --option Dpkg::Options::=--force-confold \
    install \
    --yes \
    "$raspotify_deb"
  rm --force -- "$raspotify_deb"
fi

systemctl daemon-reload
systemctl enable raspotify.service
systemctl restart raspotify.service
systemctl is-active --quiet raspotify.service

echo "GH-005 Raspotify provisioning completed."
