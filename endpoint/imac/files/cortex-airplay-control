#!/bin/bash

set -uo pipefail
export LC_ALL=C

if [[ $# -ne 0 ]]; then
  echo "Usage: $0" >&2
  exit 1
fi

coordinator_url_file=/etc/cortex-endpoint/coordinator-url
airplay_helper=/usr/local/bin/cortex-endpoint-airplay
connection_pid=
previous_cpu_idle=
previous_cpu_total=

if [[ ! -r $coordinator_url_file ]]; then
  echo "The endpoint coordinator URL is not configured." >&2
  exit 1
fi

mapfile -t coordinator_url_lines < "$coordinator_url_file"

if [[ ${#coordinator_url_lines[@]} -ne 1 ]]; then
  echo "The endpoint coordinator URL must contain exactly one line." >&2
  exit 1
fi

coordinator_url=${coordinator_url_lines[0]%/}

if [[ ! $coordinator_url =~ ^http://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]]; then
  echo "The endpoint coordinator URL must be a local HTTP origin." >&2
  exit 1
fi

if [[ ! -x $airplay_helper ]]; then
  echo "The endpoint AirPlay helper is not installed." >&2
  exit 1
fi

if [[ ! -x /usr/bin/nc ]]; then
  echo "OpenBSD netcat is not installed." >&2
  exit 1
fi

cleanup() {
  if [[ -n $connection_pid ]]; then
    kill "$connection_pid" 2>/dev/null || true
  fi
}

trap cleanup EXIT
trap 'exit 0' HUP INT TERM

send_response() {
  local status=$1
  local body=$2

  printf \
    'HTTP/1.1 %s\r\nContent-Type: application/json\r\nContent-Length: %d\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: %s\r\nAccess-Control-Allow-Methods: GET, POST, OPTIONS\r\nAccess-Control-Allow-Private-Network: true\r\nVary: Origin\r\nConnection: close\r\n\r\n%s' \
    "$status" \
    "${#body}" \
    "$coordinator_url" \
    "$body" \
    >&"$response_fd"
}

read_cpu_counters() {
  local label user nice system idle iowait irq softirq steal

  read -r label user nice system idle iowait irq softirq steal _ < /proc/stat
  cpu_idle=$((idle + iowait))
  cpu_total=$((user + nice + system + idle + iowait + irq + softirq + steal))
}

read_temperature() {
  local input sample
  temperature_milli=

  for input in \
    /sys/class/thermal/thermal_zone*/temp \
    /sys/class/hwmon/hwmon*/temp*_input
  do
    [[ -r $input ]] || continue
    IFS= read -r sample < "$input" || continue
    [[ $sample =~ ^[0-9]+$ ]] || continue

    if [[ $sample -lt 1000 ]]; then
      sample=$((sample * 1000))
    fi
    if [[ -z $temperature_milli || $sample -gt $temperature_milli ]]; then
      temperature_milli=$sample
    fi
  done
}

system_stats() {
  local key value
  local memory_available_kib=
  local memory_total_kib=

  read_cpu_counters
  cpu_delta=$((cpu_total - previous_cpu_total))
  idle_delta=$((cpu_idle - previous_cpu_idle))
  if [[ $cpu_delta -gt 0 ]]; then
    cpu_percent=$(awk \
      -v total="$cpu_delta" \
      -v idle="$idle_delta" \
      'BEGIN { printf "%.1f", 100 * (total - idle) / total }')
  else
    cpu_percent=0
  fi
  previous_cpu_idle=$cpu_idle
  previous_cpu_total=$cpu_total

  while read -r key value _; do
    case "$key" in
      MemTotal:) memory_total_kib=$value ;;
      MemAvailable:) memory_available_kib=$value ;;
    esac
  done < /proc/meminfo

  memory_used_kib=$((memory_total_kib - memory_available_kib))
  memory_percent=$(awk \
    -v total="$memory_total_kib" \
    -v used="$memory_used_kib" \
    'BEGIN { printf "%.1f", 100 * used / total }')
  memory_used_mib=$((memory_used_kib / 1024))
  memory_total_mib=$((memory_total_kib / 1024))

  read -r load_one _ < /proc/loadavg
  read -r uptime_value _ < /proc/uptime
  uptime_seconds=${uptime_value%%.*}

  read_temperature
  if [[ -n $temperature_milli ]]; then
    temperature_c=$(awk \
      -v temperature="$temperature_milli" \
      'BEGIN { printf "%.1f", temperature / 1000 }')
  else
    temperature_c=null
  fi

  printf -v stats_body \
    '{"cpuPercent":%s,"memoryPercent":%s,"memoryUsedMiB":%d,"memoryTotalMiB":%d,"temperatureC":%s,"loadOne":%s,"uptimeSeconds":%d}' \
    "$cpu_percent" \
    "$memory_percent" \
    "$memory_used_mib" \
    "$memory_total_mib" \
    "$temperature_c" \
    "$load_one" \
    "$uptime_seconds"
}

read_cpu_counters
previous_cpu_idle=$cpu_idle
previous_cpu_total=$cpu_total

while true; do
  coproc /usr/bin/nc -l -N 127.0.0.1 38019
  connection_pid=$COPROC_PID
  request_fd=${COPROC[0]}
  response_fd=${COPROC[1]}
  method=
  path=
  protocol=
  origin=

  if IFS=' ' read -r -t 1 method path protocol <&"$request_fd"; then
    header_count=0
    while IFS= read -r -t 1 header <&"$request_fd"; do
      header=${header%$'\r'}

      if [[ -z $header ]]; then
        break
      fi

      header_count=$((header_count + 1))
      if [[ $header_count -gt 64 ]]; then
        break
      fi

      header_name=${header%%:*}
      if [[ ${header_name,,} == origin ]]; then
        origin=${header#*:}
        origin=${origin#"${origin%%[![:space:]]*}"}
      fi
    done

    if [[ $origin != "$coordinator_url" ]]; then
      send_response "403 Forbidden" '{"error":"Origin not allowed."}'
    elif [[ $method == OPTIONS ]]; then
      send_response "204 No Content" ""
    elif [[ $method == GET && $path == /status ]]; then
      state=$("$airplay_helper" status)
      send_response "200 OK" "{\"state\":\"$state\"}"
    elif [[ $method == GET && $path == /stats ]]; then
      system_stats
      send_response "200 OK" "$stats_body"
    elif [[ $method == POST && $path == /on ]]; then
      if "$airplay_helper" receiver-on >/dev/null 2>&1; then
        send_response "200 OK" '{"state":"on"}'
      else
        send_response "500 Internal Server Error" \
          '{"error":"AirPlay could not start."}'
      fi
    elif [[ $method == POST && $path == /off ]]; then
      if "$airplay_helper" receiver-off >/dev/null 2>&1; then
        send_response "200 OK" '{"state":"off"}'
      else
        send_response "500 Internal Server Error" \
          '{"error":"AirPlay could not stop."}'
      fi
    else
      send_response "404 Not Found" '{"error":"Route not found."}'
    fi
  fi

  exec {request_fd}<&-
  exec {response_fd}>&-
  if ! wait "$connection_pid" 2>/dev/null; then
    echo "The AirPlay control listener failed." >&2
    exit 1
  fi
  connection_pid=
done
