<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <keyboard>
    <keybind key="C-A-Return">
      <action name="Execute">
        <command>xterm -fa monospace -fs 18</command>
      </action>
    </keybind>
    <keybind key="C-A-1">
      <action name="Execute">
        <command>/usr/local/bin/cortex-endpoint-airplay today</command>
      </action>
    </keybind>
    <keybind key="C-A-2">
      <action name="Execute">
        <command>/usr/local/bin/cortex-endpoint-airplay music</command>
      </action>
    </keybind>
    <keybind key="C-A-3">
      <action name="Execute">
        <command>/usr/local/bin/cortex-endpoint-airplay camera</command>
      </action>
    </keybind>
    <keybind key="C-A-Up">
      <action name="Execute">
        <command>/usr/local/bin/cortex-endpoint-headphone-volume up</command>
      </action>
    </keybind>
    <keybind key="C-A-Down">
      <action name="Execute">
        <command>/usr/local/bin/cortex-endpoint-headphone-volume down</command>
      </action>
    </keybind>
    <keybind key="C-A-4">
      <action name="Execute">
        <command>/usr/local/bin/cortex-endpoint-airplay airplay</command>
      </action>
    </keybind>
  </keyboard>
  <applications>
    <application name="Skärmen" class="GStreamer">
      <decor>no</decor>
      <focus>yes</focus>
      <layer>above</layer>
      <fullscreen>yes</fullscreen>
    </application>
  </applications>
</openbox_config>
