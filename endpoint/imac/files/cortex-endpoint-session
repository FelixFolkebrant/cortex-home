#!/bin/sh

set -eu

pulseaudio --start --exit-idle-time=-1
/usr/local/bin/cortex-endpoint-audio-route >/dev/null

xset -dpms
xset s off
xset s noblank

coordinator_url_file=/etc/cortex-endpoint/coordinator-url

if [ ! -r "$coordinator_url_file" ]; then
  echo "The coordinator URL is not configured." >&2
  exit 1
fi

coordinator_url=$(sed -n '1p' "$coordinator_url_file")

case "$coordinator_url" in
  http://*) ;;
  *)
    echo "The coordinator URL is invalid." >&2
    exit 1
    ;;
esac

display_output=$(xrandr --query | awk '$2 == "connected" { print $1; exit }')

if [ -z "$display_output" ]; then
  echo "No connected display was detected." >&2
  exit 1
fi

xrandr --output "$display_output" --mode 1920x1200 --primary

openbox --sm-disable &
openbox_pid=$!
unclutter -idle 0.5 -root &
unclutter_pid=$!

cleanup() {
  if [ -x /usr/local/bin/cortex-endpoint-airplay ]; then
    /usr/local/bin/cortex-endpoint-airplay stop-local || true
  fi

  kill \
    "$openbox_pid" \
    "$unclutter_pid" \
    2>/dev/null ||
    true
}

trap cleanup EXIT
trap 'exit 0' HUP INT TERM

while true; do
  /snap/bin/chromium \
    --autoplay-policy=no-user-gesture-required \
    --disable-session-crashed-bubble \
    --kiosk \
    --no-first-run \
    "$coordinator_url"
  sleep 2
done
