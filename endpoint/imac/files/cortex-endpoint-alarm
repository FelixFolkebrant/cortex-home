#!/bin/bash

set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 || ! $1 =~ ^(start|stop|status|list|select|selected|ready)$ ]]; then
  echo "Usage: $0 <start|stop|status|list|select|selected|ready> [file]" >&2
  exit 1
fi

audio_dir=/var/lib/cortex-endpoint/alarm-audio
selection_file=/home/cortex-endpoint/.config/cortex-alarm-file
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
state_dir="$runtime_dir/cortex-alarm"
pid_file="$state_dir/player.pid"

valid_file_name() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._\ -]{0,127}\.mp3$ ]]
}

selected_file() {
  local name=wake-alarm.mp3
  if [[ -r $selection_file ]]; then
    IFS= read -r name < "$selection_file" || true
  fi
  valid_file_name "$name" || return 1
  printf '%s/%s\n' "$audio_dir" "$name"
}

alarm_file() {
  local file
  file=$(selected_file) || return 1
  [[ -f $file && -r $file ]] || return 1
  printf '%s\n' "$file"
}

list_files() {
  local file name
  [[ -d $audio_dir ]] || return 0
  while IFS= read -r -d '' file; do
    name=$(basename "$file")
    valid_file_name "$name" && printf '%s\n' "$name"
  done < <(/usr/bin/find "$audio_dir" -maxdepth 1 -type f -name '*.mp3' -print0 | /usr/bin/sort -z)
}

player_pid() {
  if [[ ! -r $pid_file ]]; then
    return 1
  fi
  local pid
  IFS= read -r pid < "$pid_file"
  if [[ ! $pid =~ ^[1-9][0-9]*$ ]] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f -- "$pid_file"
    return 1
  fi
  printf '%s\n' "$pid"
}

case $1 in
  status)
    if ! alarm_file >/dev/null; then
      printf 'missing\n'
    elif player_pid >/dev/null; then
      printf 'playing\n'
    else
      printf 'stopped\n'
    fi
    ;;
  list)
    [[ $# -eq 1 ]] || exit 1
    list_files
    ;;
  selected)
    [[ $# -eq 1 ]] || exit 1
    basename "$(selected_file)"
    ;;
  select)
    [[ $# -eq 2 ]] && valid_file_name "$2"
    file="$audio_dir/$2"
    [[ -f $file && -r $file ]] || exit 1
    install -d --mode=700 "$(dirname "$selection_file")"
    temporary="$selection_file.$$"
    printf '%s\n' "$2" > "$temporary"
    mv -f -- "$temporary" "$selection_file"
    ;;
  ready)
    [[ $# -eq 1 ]]
    alarm_file >/dev/null
    ;;
  start)
    if ! file=$(alarm_file); then
      echo "The selected alarm file is not readable." >&2
      exit 1
    fi
    if player_pid >/dev/null; then
      exit 0
    fi
    install -d --mode=700 "$state_dir"
    sink_name=$(/usr/local/bin/cortex-endpoint-audio-route)
    XDG_RUNTIME_DIR="$runtime_dir" \
      PULSE_SINK="$sink_name" \
      /usr/bin/mpg123 --loop -1 --quiet "$file" >/dev/null 2>&1 &
    printf '%s\n' "$!" > "$pid_file"
    ;;
  stop)
    if pid=$(player_pid); then
      kill -TERM "$pid" 2>/dev/null || true
      rm -f -- "$pid_file"
    fi
    ;;
esac
