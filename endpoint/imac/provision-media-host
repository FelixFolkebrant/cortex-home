#!/bin/bash

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "Run this installer as root." >&2
  exit 1
fi

source_dir=$(cd -- "$(dirname -- "$0")" && pwd)
coordinator_url_file=/etc/cortex-endpoint/coordinator-url

if [[ ! -r $coordinator_url_file ]]; then
  echo "The endpoint coordinator URL is not configured." >&2
  exit 1
fi

mapfile -t coordinator_url_lines < "$coordinator_url_file"

if [[ ${#coordinator_url_lines[@]} -ne 1 ]]; then
  echo "The endpoint coordinator URL must contain exactly one line." >&2
  exit 1
fi

coordinator_url=${coordinator_url_lines[0]%/}

if [[ ! $coordinator_url =~ ^http://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]]; then
  echo "The endpoint coordinator URL must be a local HTTP origin." >&2
  exit 1
fi

coordinator_origin="$coordinator_url/"
policy_file=/var/snap/chromium/current/policies/managed/cortex-home-media.json
playback_helper=/usr/local/bin/cortex-speech-qualification-playback
playback_sudoers=/etc/sudoers.d/cortex-speech-qualification-playback

install -d --owner=root --group=root --mode=755 "$(dirname -- "$policy_file")"
install -D --owner=root --group=root --mode=644 /dev/null "$policy_file"
printf \
  '{\n  "AudioCaptureAllowedUrls": ["%s"],\n  "OverrideSecurityRestrictionsOnInsecureOrigin": ["%s"]\n}\n' \
  "$coordinator_origin" \
  "$coordinator_origin" \
  > "$policy_file"

/usr/sbin/visudo \
  --check \
  --file="$source_dir/cortex-speech-qualification-playback.sudoers"
install --owner=root --group=root --mode=755 \
  "$source_dir/cortex-endpoint-audio-route" \
  /usr/local/bin/cortex-endpoint-audio-route
install --owner=root --group=root --mode=755 \
  "$source_dir/cortex-endpoint-headphone-volume" \
  /usr/local/bin/cortex-endpoint-headphone-volume
install --owner=root --group=root --mode=755 \
  "$source_dir/cortex-endpoint-session" \
  /usr/local/bin/cortex-endpoint-session
install --owner=root --group=root --mode=755 \
  "$source_dir/cortex-raspotify" \
  /usr/local/bin/cortex-raspotify
install --owner=root --group=root --mode=755 \
  "$source_dir/cortex-speech-qualification-capture" \
  /usr/local/bin/cortex-speech-qualification-capture
install --owner=root --group=root --mode=755 \
  "$source_dir/cortex-speech-qualification-playback" \
  "$playback_helper"
install --owner=root --group=root --mode=440 \
  "$source_dir/cortex-speech-qualification-playback.sudoers" \
  "$playback_sudoers"
install --owner=cortex-endpoint --group=cortex-endpoint --mode=644 \
  "$source_dir/openbox-rc.xml" \
  /home/cortex-endpoint/.config/openbox/rc.xml

unset coordinator_url coordinator_origin coordinator_url_lines

systemctl restart lightdm.service
systemctl restart raspotify.service

amixer -c 0 sset Master 80% unmute
amixer -c 0 sset Speaker mute
amixer -c 0 sset Headphone 60% unmute
alsactl store 0

echo "Cortex Home endpoint media policy installation completed."
