#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
remote_dir=$(ssh imac mktemp -d)

case "$remote_dir" in
  /tmp/tmp.*) ;;
  *)
    echo "Unexpected remote temporary directory: $remote_dir" >&2
    exit 1
    ;;
esac

cleanup() {
  ssh imac "rm -rf -- '$remote_dir'" || true
}

trap cleanup EXIT
trap 'exit 1' HUP INT TERM

scp -q \
  "$script_dir/files/cortex-airplay-control" \
  "$script_dir/files/cortex-endpoint-alarm" \
  "$script_dir/files/cortex-endpoint-rtc-suspend" \
  "$script_dir/files/cortex-endpoint-rtc-suspend.sudoers" \
  "$script_dir/files/cortex-endpoint-session" \
  "$script_dir/provision-alarm-host" \
  "imac:$remote_dir/"

ssh -tt imac "sudo '$remote_dir/provision-alarm-host'"
